NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://massar:massar@localhost:5432/massar_fleet
DB_SSL=false
DB_SYNCHRONIZE=false
RUN_MIGRATIONS=false
JWT_ACCESS_SECRET=replace-with-a-long-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
AUTH_RATE_LIMIT_TTL=60000
AUTH_RATE_LIMIT_LIMIT=10
LOG_LEVEL=info
